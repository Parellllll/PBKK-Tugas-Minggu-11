CI_ENVIRONMENT = development
app.baseURL = ''
app.indexPage = ''

# Konfigurasi Database Default: SQLite3 (tersimpan otomatis di writable/shopease_auth.db)
database.default.database = shopease_auth.db
database.default.DBDriver = SQLite3
database.default.foreignKeys = true

